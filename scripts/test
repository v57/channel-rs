#!/usr/bin/env bash
set -euo pipefail
# In the Hub checkout this runs in its toolchain container (HubTools/hub-run); elsewhere it runs here.
hub_run="$(dirname "$0")/../../../HubTools/hub-run"
[[ -n "${HUB_TOOLCHAIN:-}" || ! -x "$hub_run" ]] || exec "$hub_run" bash "$0" "$@"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
cargo test --workspace
# QUIC (the optional `quic` feature): frames, wire rules, trust and interop both ways with the TS reference,
# whose fixture runs on CHANNEL_TEST_PORT (default 2101; started when nothing listens there)
cargo test -p channel-rs-core --features quic
cargo check -p channel-rs --features quic
